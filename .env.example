# MongoDB (must be a replica set: Atlas always is). Atlas example:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nokshi?retryWrites=true&w=majority
# Local without installing MongoDB: run `npm run db:local`, then use:
DATABASE_URL="mongodb://127.0.0.1:27017/nokshi?replicaSet=rs0"

# Protects GET /api/cron/product-sync (scheduled product auto-sync). 16+ characters.
CRON_SECRET=""

# Application
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Public identifier, not a secret. Must match stores.widget_key in the database.
NEXT_PUBLIC_WIDGET_KEY="demo-widget-key"
WIDGET_PUBLIC_KEY="demo-widget-key"

# AI provider fallback. Prefer Admin → AI model (encrypted, per store; overrides these).
# AI_PROVIDER: anthropic | openai | openrouter | groq | gemini | ollama | openai-compatible
# With no key here or in the dashboard, the widget runs in demo mode.
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Commerce
COMMERCE_PROVIDER="internal"
# Extra hosts allowed for checkout redirects, comma separated (store domain is always allowed).
COMMERCE_TRUSTED_HOSTS=""

# Admin bootstrap (used by prisma/seed.mjs only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Store Admin"
