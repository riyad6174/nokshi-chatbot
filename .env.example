# MongoDB (must be a replica set: Atlas always is). Atlas example:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nokshi?retryWrites=true&w=majority
# Local without installing MongoDB: run `npm run db:local`, then use:
DATABASE_URL="mongodb://127.0.0.1:27017/nokshi?replicaSet=rs0"

# Protects GET /api/cron/product-sync (scheduled product auto-sync). 16+ characters.
CRON_SECRET=""

# Application
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Public identifier, not a secret. Must match stores.widget_key in the database.
NEXT_PUBLIC_WIDGET_KEY="demo-widget-key"
WIDGET_PUBLIC_KEY="demo-widget-key"

# AI provider fallback. Prefer Admin → AI model (encrypted, per store; overrides these).
# AI_PROVIDER: anthropic | openai | openrouter | groq | gemini | ollama | openai-compatible
# With no key here or in the dashboard, the widget runs in demo mode.
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Voice assistant speech (speech-to-text + text-to-speech).
# SPEECH_PROVIDER: browser (free, uses the visitor's browser; recognition only in Chrome/Edge) | azure | openai
# azure: SPEECH_API_KEY + SPEECH_REGION (e.g. southeastasia). Voices default to en-US-AvaMultilingualNeural / bn-BD-NabanitaNeural.
# openai: SPEECH_API_KEY (+ SPEECH_BASE_URL for compatible APIs). Voices default to "alloy".
SPEECH_PROVIDER="browser"
SPEECH_API_KEY=""
SPEECH_REGION=""
SPEECH_BASE_URL="https://api.openai.com/v1"
SPEECH_STT_MODEL="gpt-4o-mini-transcribe"
SPEECH_TTS_MODEL="gpt-4o-mini-tts"
SPEECH_VOICE_EN=""
SPEECH_VOICE_BN=""
# Azure voices. Any voice from your region's list works, including multilingual HD voices for Bangla,
# e.g. SPEECH_VOICE_BN="en-IN-Aarti:DragonHDLatestNeural" (more natural, ~2 s slower to start speaking).
# Speaking speed: "+10%" is a little faster than normal.
SPEECH_RATE="+10%"
# Voice engine: realtime (OpenAI Realtime over WebRTC, fastest, uses the store's OpenAI key from
# Admin -> AI model) or cascade (the SPEECH_PROVIDER pipeline above). Realtime falls back to cascade
# automatically when the store's AI provider isn't OpenAI.
VOICE_ENGINE="realtime"
REALTIME_MODEL="gpt-realtime-2"
# Voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
REALTIME_VOICE="marin"
# How the live voice speaks (tone, warmth, pace), in plain words.
REALTIME_VOICE_STYLE="A warm, cheerful young Bangladeshi woman helping a customer on the phone: relaxed and natural, smiling while she talks, quick and easy-going, never stiff, robotic or overly formal."
# Speaking speed: 1 is normal, 1.08 a little livelier (0.75 to 1.4).
REALTIME_VOICE_SPEED="1.08"
# Hard stop for one hands-free voice session (cost guard).
VOICE_MAX_SESSION_MINUTES="15"

# Commerce
COMMERCE_PROVIDER="internal"
# Extra hosts allowed for checkout redirects, comma separated (store domain is always allowed).
COMMERCE_TRUSTED_HOSTS=""

# Admin bootstrap (used by prisma/seed.mjs only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Store Admin"
