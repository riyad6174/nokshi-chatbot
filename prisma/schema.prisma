generator client {
  provider = "prisma-client-js"
}

// MongoDB (Atlas in production). Transactions require a replica set, which Atlas always is;
// local development and tests use mongodb-memory-server's single-node replica set.
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// JSON-ish settings are stored as strings to keep one parsing path (see parseJsonArray/parseJsonObject).

model Store {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  websiteDomain         String
  widgetKey             String   @unique
  currency              String
  defaultLocale         String
  supportedLocales      String   @default("[\"en\"]")
  trustedCheckoutHosts  String   @default("[]")
  // [{"id":"dhaka","label":"Inside Dhaka","feeMinor":8000}, ...]
  shippingZones         String   @default("[]")
  freeShippingOverMinor Int?
  codEnabled            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  settings      ChatbotSettings?
  productSource ProductSource?
  products      Product[]
  variants      ProductVariant[]
  knowledge     KnowledgeDocument[]
  sessions      ChatSession[]
  conversations Conversation[]
  carts         Cart[]
  checkouts     CheckoutSession[]
  orders        Order[]
  uploads       Upload[]
  customers     CustomerProfile[]
  events        CustomerEvent[]
  jobs          Job[]
  aiTurns       AiTurnLog[]
  campaigns     MarketingCampaign[]
  marketingMessages MarketingMessage[]

  @@index([websiteDomain])
}

model ChatbotSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId            String   @unique @db.ObjectId
  provider           String   @default("openai-compatible")
  model              String   @default("")
  aiBaseUrl          String   @default("")
  aiApiKeyEncrypted  String   @default("")
  aiApiKeyLast4      String   @default("")
  aiEffort           String   @default("medium")
  assistantName      String   @default("Shopping assistant")
  // friendly | professional | playful | luxury | custom
  tone               String   @default("friendly")
  customTone         String   @default("")
  // straightforward | explainer | consultative
  conversationStyle  String   @default("consultative")
  systemInstructions String   @default("")
  welcomeMessage     String
  productGreeting    String   @default("")
  fallbackMessage    String
  // [{"label":"Looking for a product","prompt":"I'm looking for a product"}, ...]
  suggestedTopics    String   @default("[]")
  handoffEnabled     Boolean  @default(true)
  handoffAfterMisses Int      @default(2)
  handoffKeywords    String   @default("[\"human\",\"agent\",\"person\",\"manager\"]")
  voiceEnabled       Boolean  @default(true)
  // Hands-free voice assistant and the spoken welcome. Optional: older documents don't have them.
  voiceAssistantEnabled Boolean?
  welcomeVoiceEnabled   Boolean?
  // {"en":"Hi! ...","bn":"..."}; empty uses the built-in greeting.
  welcomeVoiceText      String?
  salesPlaybookEnabled  Boolean?
  // Complementary categories for cross-selling, e.g. {"Backpacks":["Water bottles","Rain covers"]}
  recommendationMap     String?
  // AI Sales & Engagement configuration (JSON, validated by src/modules/sales/config.ts). Empty uses the
  // "general" industry preset, so existing stores keep their current behaviour.
  salesConfig           String?
  attachmentsEnabled Boolean  @default(true)
  enabledFeatures    String   @default("[\"product_cards\",\"cart_tools\",\"knowledge_search\",\"orders\"]")
  widgetTheme        String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Where the catalog comes from. "api" mode syncs a public product API into the Product collection
/// (the same collection the storefront uses), so products are never stored twice.
model ProductSource {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String    @unique @db.ObjectId
  mode            String    @default("manual")
  apiUrl          String    @default("")
  // Field mapping, e.g. {"itemsPath":"data.products","id":"id","name":"title","price":"price",...}
  mapping         String    @default("{}")
  priceUnit       String    @default("major")
  autoSync        Boolean   @default(false)
  intervalMinutes Int       @default(60)
  lastSyncAt      DateTime?
  lastStatus      String    @default("never")
  lastError       String    @default("")
  lastCounts      String    @default("{}")
  syncLockedUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId           String   @db.ObjectId
  // "manual" or "api"; API products are updated by sync and marked inactive when they disappear.
  sourceType        String   @default("manual")
  externalProductId String?
  name              String
  slug              String
  description       String
  category          String
  brand             String   @default("")
  imageUrl          String?
  priceMinor        Int
  currency          String
  status            String   @default("active")
  attributes        String   @default("{}")
  // Semantic search (optional): vector of the product text and a hash of the text it was made from.
  embedding         Float[]
  embeddingHash     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]
  cartItems CartItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, category])
  @@index([storeId, externalProductId])
}

model ProductVariant {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  productId          String   @db.ObjectId
  storeId            String   @db.ObjectId
  externalVariantId  String?
  sku                String
  title              String
  options            String   @default("{}")
  priceOverrideMinor Int?
  stockStatus        String   @default("in_stock")
  stockQuantity      Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, sku])
  @@index([storeId])
}

model KnowledgeDocument {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String   @db.ObjectId
  title           String
  content         String
  sourceType      String   @default("manual")
  sourceReference String?
  status          String   @default("ready")
  contentHash     String
  embedding       Float[]
  embeddingHash   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, title])
  @@index([storeId, status])
}

model ChatSession {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId        String   @db.ObjectId
  visitorId      String
  locale         String
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  // Sales/engagement state for this visit (JSON): suggestions shown, dismissed, opt-out, limits.
  engagement     String?

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  carts         Cart[]

  @@index([storeId])
  @@index([visitorId])
}

model Conversation {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId          String    @db.ObjectId
  sessionId        String    @db.ObjectId
  // bot: AI replies · waiting_human: handed off, waiting for an agent · human: agent replying · closed
  status           String    @default("bot")
  handoffReason    String    @default("")
  handoffAt        DateTime?
  assignedAdminId  String?   @db.ObjectId
  assignedName     String    @default("")
  missCount        Int       @default(0)
  unreadForAdmin   Int       @default(0)
  customerName     String    @default("")
  customerPhone    String    @default("")
  contextProductId String?   @db.ObjectId
  lastMessageAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session  ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([storeId, status, lastMessageAt])
  @@index([sessionId])
}

type MessageAttachment {
  uploadId   String
  name       String
  mime       String
  size       Int
  // image | audio | file
  kind       String
  transcript String?
  durationMs Int?
}

model Message {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  conversationId    String              @db.ObjectId
  // user | assistant | agent | event
  role              String
  content           String
  structuredContent String?
  attachments       MessageAttachment[]
  senderName        String              @default("")
  createdAt         DateTime            @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Customer attachments and voice notes. Stored in MongoDB (max 5 MB each) so no extra storage service is needed.
model Upload {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId        String   @db.ObjectId
  sessionId      String?  @db.ObjectId
  conversationId String?  @db.ObjectId
  name           String
  mime           String
  size           Int
  data           Bytes
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId   String   @db.ObjectId
  sessionId String   @db.ObjectId
  // active | checked_out | abandoned
  status    String   @default("active")
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session          ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([storeId])
  @@index([sessionId, status])
}

model CartItem {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId             String   @db.ObjectId
  productId          String   @db.ObjectId
  productVariantId   String?  @db.ObjectId
  quantity           Int
  priceSnapshotMinor Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

type CustomerDetails {
  name    String
  phone   String
  email   String  @default("")
  address String
  city    String  @default("")
  notes   String  @default("")
}

model CheckoutSession {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId          String           @db.ObjectId
  cartId           String           @db.ObjectId
  commerceProvider String
  externalCartId   String?
  token            String           @unique
  checkoutUrl      String
  // prepared | completed | expired | failed
  status           String           @default("prepared")
  idempotencyKey   String
  lines            String
  subtotalMinor    Int
  currency         String
  // Details collected in chat; the checkout page pre-fills them.
  customer         CustomerDetails?
  // Set when the assistant showed an order confirmation card (voice/chat ordering, cash on delivery).
  shippingZoneId   String?
  proposedAt       DateTime?
  orderId          String?          @db.ObjectId
  createdAt        DateTime         @default(now())
  expiresAt        DateTime?
  completedAt      DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, idempotencyKey])
  @@index([storeId, status])
}

type OrderLine {
  productId      String
  variantId      String?
  name           String
  variantTitle   String?
  sku            String?
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int
}

type OrderStatusEvent {
  status String
  note   String   @default("")
  at     DateTime
  by     String   @default("system")
}

model Order {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  storeId           String             @db.ObjectId
  orderNumber       String             @unique
  checkoutSessionId String?            @db.ObjectId
  sessionId         String?            @db.ObjectId
  conversationId    String?            @db.ObjectId
  customer          CustomerDetails
  items             OrderLine[]
  subtotalMinor     Int
  shippingMinor     Int
  totalMinor        Int
  currency          String
  shippingZone      String             @default("")
  // cod | online
  paymentMethod     String
  // pending | paid | refunded
  paymentStatus     String             @default("pending")
  // placed | confirmed | processing | shipped | delivered | cancelled | refunded
  status            String             @default("placed")
  statusHistory     OrderStatusEvent[]
  trackingNumber    String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
}

/// Marketing permission. Stored only when the customer explicitly agreed, with the question asked.
type MarketingConsent {
  granted  Boolean
  // sms | whatsapp | email
  channels String[]
  at       DateTime
  // voice | chat | checkout
  source   String
  wording  String
  // What the customer said when agreeing (audit trail).
  evidence String   @default("")
}

/// Everything the store knows about a shopper, for follow-up marketing. Linked to chat sessions by
/// visitor id, and merged by phone number once the customer gives it.
model CustomerProfile {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  storeId          String            @db.ObjectId
  // normalizePhone(phone): last 10 digits; "" until known.
  phoneKey         String            @default("")
  phone            String            @default("")
  name             String            @default("")
  email            String            @default("")
  // Last delivery details, offered again on the next order ("use your saved address?").
  // Optional: profiles created before these fields don't have them.
  address          String?
  city             String?
  deliveryAreaId   String?
  preferredLocale  String            @default("")
  interests        String[]
  budgetHint       String            @default("")
  visitorIds       String[]
  marketingConsent MarketingConsent?
  // Set when the customer unsubscribed from marketing (consent is withdrawn at the same time).
  unsubscribedAt   DateTime?
  // The customer asked the assistant to stop proactive suggestions.
  proactiveOptOut  Boolean?
  orderCount       Int               @default(0)
  totalSpentMinor  Int               @default(0)
  lastOrderAt      DateTime?
  firstSeenAt      DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events   CustomerEvent[]
  messages MarketingMessage[]

  @@index([storeId, lastSeenAt])
  @@index([storeId, phoneKey])
  @@index([storeId, visitorIds])
}

/// Shopping activity for marketing and analytics.
model CustomerEvent {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId    String           @db.ObjectId
  sessionId  String           @db.ObjectId
  visitorId  String
  profileId  String?          @db.ObjectId
  // viewed_product | added_to_cart | removed_from_cart | checkout_started | order_placed | abandoned_cart | voice_turn
  // | searched | compared | recommendation_shown | recommendation_clicked | proactive_shown | proactive_dismissed
  // | proactive_opt_out | marketing_sent | marketing_clicked | cart_recovered
  type       String
  productId  String?
  cartId     String?
  orderId    String?
  valueMinor Int?
  meta       String           @default("{}")
  at         DateTime         @default(now())

  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  profile CustomerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([storeId, type, at])
  @@index([storeId, visitorId, at])
  @@index([cartId, type])
}

/// Durable background work (reminders, campaigns, embeddings). Claimed atomically by
/// src/modules/jobs/job.service.ts, so several app instances can run the queue at once.
model Job {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId     String?   @db.ObjectId
  type        String
  payload     String    @default("{}")
  // queued | running | done | failed | cancelled
  status      String    @default("queued")
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedUntil DateTime?
  lockedBy    String    @default("")
  lastError   String    @default("")
  // Same type + key is enqueued once (e.g. one reminder per cart). Always set: unique indexes treat nulls as equal.
  dedupeKey   String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([type, dedupeKey])
  @@index([status, runAt])
  @@index([storeId, type, status])
}

type AiToolCallLog {
  name String
  ok   Boolean
  code String  @default("")
  ms   Int     @default(0)
}

/// One assistant turn, for reliability and quality reporting (success rate, latency, tool errors).
model AiTurnLog {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  storeId        String          @db.ObjectId
  conversationId String          @db.ObjectId
  sessionId      String          @db.ObjectId
  // text | voice
  channel        String
  // live | demo
  mode           String
  model          String          @default("")
  // answered | missed | error | handoff
  outcome        String
  latencyMs      Int
  firstTokenMs   Int?
  toolCalls      AiToolCallLog[]
  toolErrorCount Int             @default(0)
  // The customer's question, truncated (for "unanswered questions" reporting).
  userText       String          @default("")
  intent         String          @default("")
  at             DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, at])
  @@index([storeId, outcome, at])
}

/// Consent-aware marketing. Kept apart from transactional order messages.
model MarketingCampaign {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String    @db.ObjectId
  name         String
  // abandoned_cart | product_followup | broadcast
  kind         String
  // email | sms | whatsapp
  channel      String
  // Segment rules (JSON, see src/modules/marketing/segments.ts).
  segment      String    @default("{}")
  subject      String    @default("")
  body         String
  // Abandoned-cart automation: wait this long after the cart was flagged.
  delayMinutes Int       @default(60)
  // draft | active | paused | completed
  status       String    @default("draft")
  launchedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages MarketingMessage[]

  @@index([storeId, kind, status])
}

model MarketingMessage {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId    String    @db.ObjectId
  campaignId String    @db.ObjectId
  profileId  String    @db.ObjectId
  channel    String
  recipient  String
  // queued | sent | skipped | failed
  status     String    @default("queued")
  reason     String    @default("")
  // One message per campaign, customer and occasion (e.g. the abandoned cart id).
  dedupeKey  String
  cartId     String?
  subject    String    @default("")
  body       String    @default("")
  sentAt     DateTime?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profile  CustomerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, profileId, dedupeKey])
  @@index([storeId, status, createdAt])
}
